{
  "name": "iina-emby",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsup",
    "build:ui": "vite build",
    "build:plugin": "tsup",
    "dev:plugin": "tsup --watch",
    "dev": "vite",
    "preview": "vite preview --open",
    "build:preview": "vite build && vite preview --open",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "install:plugin": "./scripts/install.sh"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.2.8",
