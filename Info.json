{
  "name": "Emby Browser",
  "identifier": "com.ghotriw.iina-emby",
  "version": "0.8.1",
  "description": "Emby plugin for IINA.",
  "ghRepo": "fjkfwz/iina-emby",
  "ghVersion": 20,
  "author": {
    "name": "Andrii Honcharov"
  },
  "entry": "dist/plugin/index.js",
  "globalEntry": "dist/plugin/global.js",
  "permissions": ["show-osd", "show-alert", "network-request", "file-system"],
  "allowedDomains": ["*"],
  "preferencesPage": "pref.html",
  "helpPage": "help.html",
  "preferenceDefaults": {
    "auto_download_enabled": true,
    "preferred_languages": "en,eng",
    "download_all_subtitles": false,
    "show_notifications": false,
    "debug_logging": false,
    "set_video_title": true,
    "open_in_new_window": false,
    "auto_login_enabled": true,
    "autoplay_next_episode": true,
    "auto_skip_outro": true,
    "sync_playback_progress": true,
    "reopen_browser_on_playback_end": true,
    "use_connected_account": false,
    "auto_open_on_launch": true,
    "remember_track_selections": true,
    "preferred_audio_language": "zh,chi,ja,jpn,en,eng",
    "preferred_audio_channel": "auto",
    "preferred_subtitle_language": "zh,chi,chs,sc,cht,tc,en",
    "auto_select_subtitles": true
  }
}
